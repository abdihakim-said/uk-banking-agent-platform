# Copy to .env. Never commit real secrets.
ANTHROPIC_API_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BANK_CONTEXT_TOKEN_SECRET=
BANK_INTERNAL_SERVICE_TOKEN=
# Provider order. Remove "rule_based" in production so an outage returns "unavailable" rather than keyword answers.
BANK_LLM_ROUTE=anthropic,private,rule_based
BANK_ANTHROPIC_MODEL=claude-opus-5-5
BANK_ANTHROPIC_EFFORT=medium
# Self-hosted fallback (Ollama or vLLM, OpenAI-compatible API)
BANK_PRIVATE_LLM_BASE_URL=
BANK_PRIVATE_LLM_MODEL=llama3.1:8b
# Production identity provider
BANK_OIDC_ISSUER=
BANK_OIDC_AUDIENCE=uk-banking-assistant
BANK_OIDC_JWKS_URL=
