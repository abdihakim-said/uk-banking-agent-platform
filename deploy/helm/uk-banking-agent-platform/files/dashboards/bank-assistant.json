    {
      "id": 17,
      "type": "timeseries",
      "title": "Tool error ratio",
      "description": "Errors include customers asking for things the bank refuses (e.g. disputing a credit).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
