          },
          "expr": "(sum by (server) (rate(mcp_tool_calls_total{outcome=\"error\"}[5m]))\n or 0 * sum by (server) (rate(mcp_tool_calls_total[5m])))\n/ clamp_min(sum by (server) (rate(mcp_tool_calls_total[5m])), 1e-9)",
